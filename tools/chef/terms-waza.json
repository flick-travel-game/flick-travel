[{"id": "wz-yaku", "name": "焼く", "reading": "やく", "journey": "waza", "category": "焼く・炒める", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍖", "mapNode": "konro:yaku", "relatedTerms": ["wz-yakiiro", "wz-jikabi"], "description": "食材に 直接 熱を あてて 火を 通す 調理です。表面に こうばしい 焼き色と 香りが つきます。魚・肉・パンなど、いろいろな 料理で 使います。"}, {"id": "wz-niru", "name": "煮る", "reading": "にる", "journey": "waza", "category": "煮る", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍲", "mapNode": "konro:niru", "relatedTerms": ["wz-otoshibuta", "wz-nitsuke"], "description": "だしや 調味料の 入った 汁の 中で 食材を 加熱する 調理です。やわらかく なり、味が 中まで しみこみます。和食でも 洋食でも よく 使います。"}, {"id": "wz-itameru", "name": "炒める", "reading": "いためる", "journey": "waza", "category": "焼く・炒める", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥘", "mapNode": "konro:itameru", "relatedTerms": ["wz-tsuyobi", "wz-furaipan"], "description": "少しの 油を 使い、鍋や フライパンで 食材を 動かしながら 加熱する 調理です。短い 時間で 仕上がり、野菜の しゃきっと した 食感が 残ります。"}, {"id": "wz-ageru", "name": "揚げる", "reading": "あげる", "journey": "waza", "category": "揚げる", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍤", "mapNode": "konro:ageru", "relatedTerms": ["wz-karaage", "wz-koromoage"], "description": "たっぷりの 油の 中で 食材を 加熱する 調理です。外は からっと、中は ふっくら 仕上がります。火と 油を 使う ときは 大人と いっしょに。"}, {"id": "wz-musu", "name": "蒸す", "reading": "むす", "journey": "waza", "category": "蒸す・ゆでる", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "♨️", "mapNode": "konro:musu", "relatedTerms": ["wz-mushiki", "wz-seiro"], "description": "湯気(水蒸気)の 熱で 食材を 加熱する 調理です。形が くずれにくく、うまみや 水分が 逃げにくいので、しっとり やわらかく 仕上がります。"}, {"id": "wz-yuderu", "name": "ゆでる", "reading": "ゆでる", "journey": "waza", "category": "蒸す・ゆでる", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥚", "mapNode": "konro:yuderu", "relatedTerms": ["wz-nabe", "wz-musu"], "description": "たっぷりの お湯の 中で 食材を 加熱する 調理です。野菜・めん・卵など、多くの 食材に 使います。あくや 余分な 油を 落とす 役目も あります。"}, {"id": "wz-taku", "name": "炊く", "reading": "たく", "journey": "waza", "category": "煮る", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍚", "mapNode": "konro:niru", "relatedTerms": ["wz-donabe", "wz-koka"], "description": "お米に 水を 吸わせて 加熱し、ごはんに する ことです。関西では 煮物を 作る ことを「炊く」と 言う ことも あります。"}, {"id": "wz-tsuyobi", "name": "強火", "reading": "つよび", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🔥", "mapNode": "konro:hikagen", "relatedTerms": ["wz-chubi", "wz-yowabi"], "description": "ほのおが 鍋の 底 全体に しっかり あたる 火の 強さです。お湯を わかす ときや、炒め物を 手早く 仕上げる ときに 使います。"}, {"id": "wz-chubi", "name": "中火", "reading": "ちゅうび", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🔥", "mapNode": "konro:hikagen", "relatedTerms": ["wz-tsuyobi", "wz-yowabi"], "description": "ほのおの 先が 鍋の 底に 少し ふれる くらいの 火の 強さです。焼き物や 煮物など、ふだんの 調理で いちばん よく 使います。"}, {"id": "wz-yowabi", "name": "弱火", "reading": "よわび", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🕯️", "mapNode": "konro:hikagen", "relatedTerms": ["wz-chubi", "wz-hikagen"], "description": "ほのおが 鍋の 底に とどかない くらいの 小さな 火です。煮こみや、こげやすい ものを ゆっくり 加熱する ときに 使います。"}, {"id": "wz-hikagen", "name": "火加減", "reading": "ひかげん", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🎚️", "mapNode": "konro:hikagen", "relatedTerms": ["wz-tsuyobi", "wz-yowabi", "wz-yonetsu"], "description": "料理に あわせて 火の 強さを 調節する ことです。同じ 食材でも 火加減で 食感や 味が 大きく 変わるので、料理人が とても 大切に する わざです。"}, {"id": "wz-ajimi", "name": "味見", "reading": "あじみ", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥄", "mapNode": "konro:aji", "relatedTerms": ["wz-kakushiaji", "wz-anbai"], "description": "料理の とちゅうや 仕上げに 少しだけ 味を たしかめる ことです。塩けや あまさを 調えて、ねらった 味に 近づけます。"}, {"id": "wz-aeru", "name": "和える", "reading": "あえる", "journey": "waza", "category": "火加減・味つけ", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥗", "mapNode": "konro:aji", "relatedTerms": ["wz-ajimi"], "description": "下ごしらえした 野菜や 魚を、ごまや みそ、酢などの 衣と まぜ合わせる ことです。食べる 直前に 和えると、水っぽく なりにくいです。"}, {"id": "wz-furaipan", "name": "フライパン", "reading": "ふらいぱん", "journey": "waza", "category": "道具・機械", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍳", "mapNode": "konro:kigu", "relatedTerms": ["wz-itameru", "wz-nabe"], "description": "浅くて 平らな 取っ手つきの 鍋です。焼く・炒める・蒸し焼きなど、いろいろな 調理に 使える 厨房の 基本の 道具です。"}, {"id": "wz-nabe", "name": "鍋", "reading": "なべ", "journey": "waza", "category": "道具・機械", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍲", "mapNode": "konro:kigu", "relatedTerms": ["wz-furaipan", "wz-donabe", "wz-atsuryokunabe"], "description": "食材を 煮る・ゆでる ための 深さの ある 道具です。アルミ・ステンレス・鉄・土など 材料が いろいろ あり、料理に あわせて 使い分けます。"}, {"id": "wz-yakiiro", "name": "焼き色", "reading": "やきいろ", "journey": "waza", "category": "焼く・炒める", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥞", "mapNode": "konro:yaku", "relatedTerms": ["wz-yaku", "wz-meiraado"], "description": "焼いたときに 食材の 表面に つく こんがりした 色です。見た目を おいしそうに し、こうばしい 香りも 生まれます。"}, {"id": "wz-karaage", "name": "から揚げ", "reading": "からあげ", "journey": "waza", "category": "揚げる", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🍗", "mapNode": "konro:ageru", "relatedTerms": ["wz-ageru", "wz-koromoage"], "description": "食材に 小麦粉や でんぷんを うすく まぶして 揚げる 方法、または その 料理です。鶏肉で よく 作ります。揚げ物は 大人と いっしょに。"}, {"id": "wz-toromi", "name": "とろみ", "reading": "とろみ", "journey": "waza", "category": "調理の科学", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🥣", "mapNode": "konro:toromi", "relatedTerms": ["wz-mizudoki", "wz-ruu"], "description": "汁に ほどよい ねばりが ある ようすです。味が 食材に からみやすく なり、冷めにくく なります。でんぷんや ルウで つけます。"}, {"id": "wz-mushiki", "name": "蒸し器", "reading": "むしき", "journey": "waza", "category": "道具・機械", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "♨️", "mapNode": "konro:kigu", "relatedTerms": ["wz-musu", "wz-seiro"], "description": "下の 段で お湯を わかし、上の 段に 食材を 入れて 湯気で 蒸す 道具です。茶わん蒸しや まんじゅう、蒸し野菜などに 使います。"}, {"id": "wz-donabe", "name": "土鍋", "reading": "どなべ", "journey": "waza", "category": "道具・機械", "difficulty": 1, "field": "調理理論", "type": "concept", "emoji": "🫕", "mapNode": "konro:kigu", "relatedTerms": ["wz-nabe", "wz-taku"], "description": "土を 焼いて 作った 鍋です。熱が ゆっくり 伝わり、冷めにくいので、鍋料理や ごはんを 炊く ときに 向いています。"}, {"id": "wz-otoshibuta", "name": "落としぶた", "reading": "おとしぶた", "journey": "waza", "category": "煮る", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍲", "mapNode": "konro:niru", "relatedTerms": ["wz-niru", "wz-nitsuke", "wz-fukumeni"], "description": "鍋より ひとまわり 小さい ふたを、食材の 上に じかに のせる わざです。少ない 煮汁でも 全体に 味が 回り、煮くずれも ふせぎます。"}, {"id": "wz-nitsuke", "name": "煮つけ", "reading": "につけ", "journey": "waza", "category": "煮る", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🐟", "mapNode": "konro:niru", "relatedTerms": ["wz-otoshibuta", "wz-nikomi"], "description": "しょうゆ・砂糖・みりんなどの 甘からい 煮汁で、短めに 煮て 味を からめる 料理です。魚の 煮つけが よく 知られています。"}, {"id": "wz-nikomi", "name": "煮こみ", "reading": "にこみ", "journey": "waza", "category": "煮る", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥘", "mapNode": "konro:niru", "relatedTerms": ["wz-yowabi", "wz-nitsuke"], "description": "たっぷりの 汁で 時間を かけて じっくり 煮る 方法です。かたい 肉も やわらかく なり、汁に うまみが 出ます。シチューや おでんなどで 使います。"}, {"id": "wz-mushiyaki", "name": "蒸し焼き", "reading": "むしやき", "journey": "waza", "category": "蒸す・ゆでる", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥟", "mapNode": "konro:musu", "relatedTerms": ["wz-musu", "wz-furaipan"], "description": "フライパンなどに ふたを して、食材から 出る 水分や 少しの 水の 湯気で 蒸しながら 焼く 方法です。ぎょうざで よく 使います。"}, {"id": "wz-keiryocup", "name": "計量カップ", "reading": "けいりょうかっぷ", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥛", "mapNode": "konro:kigu", "relatedTerms": ["wz-keiryo"], "description": "水や だし、調味料などの 量を はかる カップです。同じ 味を くり返し 作るために、プロの 厨房でも 欠かせない 道具です。"}, {"id": "wz-keiryo", "name": "計量スプーン", "reading": "けいりょうすぷーん", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥄", "mapNode": "konro:kigu", "relatedTerms": ["wz-keiryocup", "wz-tamajakushi"], "description": "調味料などの 量を はかる ための スプーンです。大小の 大きさが あり、同じ 味を 何度でも 作れるように するための 道具です。"}, {"id": "wz-tamajakushi", "name": "玉じゃくし", "reading": "たまじゃくし", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥄", "mapNode": "konro:kigu", "relatedTerms": ["wz-yukihiranabe", "wz-keiryo"], "description": "汁ものを すくう ための、丸い 皿の ついた 道具です。「おたま」とも 呼ばれます。汁を 器に 分ける ときに 使います。", "acceptedReadings": ["たまじゃくし", "おたま"]}, {"id": "wz-suage", "name": "素揚げ", "reading": "すあげ", "journey": "waza", "category": "揚げる", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍆", "mapNode": "konro:ageru", "relatedTerms": ["wz-koromoage", "wz-karaage"], "description": "衣も 粉も つけずに、食材を そのまま 揚げる 方法です。なすや かぼちゃなど、野菜の 色や 形が きれいに 生きます。"}, {"id": "wz-koromoage", "name": "衣揚げ", "reading": "ころもあげ", "journey": "waza", "category": "揚げる", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍤", "mapNode": "konro:ageru", "relatedTerms": ["wz-suage", "wz-karaage", "wz-nidoage"], "description": "小麦粉や 卵、水で 作った 衣を つけて 揚げる 方法です。天ぷらや フライが これに あたり、衣が 食材の 水分を 守ります。"}, {"id": "wz-nidoage", "name": "二度揚げ", "reading": "にどあげ", "journey": "waza", "category": "揚げる", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍗", "mapNode": "konro:ageru", "relatedTerms": ["wz-koromoage", "wz-yonetsu"], "description": "一度 揚げて 少し 休ませ、もう一度 揚げる 方法です。休ませる あいだに 余熱で 中まで 火が 通り、外が からっと 仕上がります。"}, {"id": "wz-atsuryokunabe", "name": "圧力鍋", "reading": "あつりょくなべ", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍲", "mapNode": "konro:kigu", "relatedTerms": ["wz-nabe", "wz-nikomi"], "description": "ふたを しっかり とじて 中の 圧力を 高め、ふつうより 高い 温度で 煮る 鍋です。かたい 肉や 豆が 短い 時間で やわらかく なります。"}, {"id": "wz-seiro", "name": "せいろ", "reading": "せいろ", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥟", "mapNode": "konro:kigu", "relatedTerms": ["wz-mushiki", "wz-musu"], "description": "木や 竹で 作った 蒸すための 道具です。よけいな 湯気を 木が 吸うので、しゅうまいや まんじゅうが べたつきにくく 仕上がります。"}, {"id": "wz-kakushiaji", "name": "隠し味", "reading": "かくしあじ", "journey": "waza", "category": "火加減・味つけ", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🤫", "mapNode": "konro:aji", "relatedTerms": ["wz-ajimi", "wz-taihi"], "description": "おもてには 出ない くらい 少しだけ 加えて、料理の 味を ひきたてる ものです。おしるこに 少しの 塩を 入れるのが よい 例です。"}, {"id": "wz-yonetsu", "name": "余熱", "reading": "よねつ", "journey": "waza", "category": "火加減・味つけ", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "♨️", "mapNode": "konro:hikagen", "relatedTerms": ["wz-hikagen", "wz-nidoage"], "description": "火を 止めた あとも 食材や 鍋に 残っている 熱です。余熱で 火が 通る ことを 考えて、少し 早めに 火を 止める ことが あります。"}, {"id": "wz-mizudoki", "name": "水溶き片栗粉", "reading": "みずどきかたくりこ", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥄", "mapNode": "konro:toromi", "relatedTerms": ["wz-toromi", "wz-koka"], "description": "片栗粉を 水で 溶いた ものです。煮汁に まわし入れて とろみを つけます。中華料理の あんかけなどで よく 使います。"}, {"id": "wz-ruu", "name": "ルウ", "reading": "るう", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍛", "mapNode": "konro:toromi", "relatedTerms": ["wz-toromi", "wz-tsunagi"], "description": "小麦粉を バターなどの 油で 炒めた ものです。シチューや カレー、ソースの とろみと コクの もとに なります。"}, {"id": "wz-yusen", "name": "湯せん", "reading": "ゆせん", "journey": "waza", "category": "蒸す・ゆでる", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🫕", "mapNode": "konro:yuderu", "relatedTerms": ["wz-gyoko", "wz-nyuka"], "description": "食材を 入れた 器ごと お湯に つけて、間接的に あたためる 方法です。チョコレートや バター、卵の ソースなど、こげやすい ものに 使います。"}, {"id": "wz-yukihiranabe", "name": "雪平鍋", "reading": "ゆきひらなべ", "journey": "waza", "category": "道具・機械", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥣", "mapNode": "konro:kigu", "relatedTerms": ["wz-nabe", "wz-tamajakushi"], "description": "片手の 取っ手が ついた、うすくて 軽い 鍋です。表面の もようが 特ちょう。熱が 早く 伝わり、みそ汁や 煮物、下ゆでに よく 使われます。"}, {"id": "wz-fukumeni", "name": "含め煮", "reading": "ふくめに", "journey": "waza", "category": "煮る", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍠", "mapNode": "konro:niru", "relatedTerms": ["wz-otoshibuta", "wz-nishime"], "description": "うすめの 味の 煮汁で 煮て、そのまま 冷ましながら 味を ゆっくり しみこませる 煮かたです。いもや 高野豆腐などで 使います。"}, {"id": "wz-jikabi", "name": "直火焼き", "reading": "じかびやき", "journey": "waza", "category": "焼く・炒める", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🔥", "mapNode": "konro:yaku", "relatedTerms": ["wz-kansetsu", "wz-yaku"], "description": "食材に ほのおや 炭の 熱を 直接 あてて 焼く 方法です。焼き鳥や 焼き魚が これに あたり、こうばしい 香りが つきます。"}, {"id": "wz-kansetsu", "name": "間接焼き", "reading": "かんせつやき", "journey": "waza", "category": "焼く・炒める", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍳", "mapNode": "konro:yaku", "relatedTerms": ["wz-jikabi", "wz-furaipan"], "description": "フライパンや 鉄板、オーブンなどを あいだに はさんで、その 熱で 焼く 方法です。むらなく 火を 通しやすい 焼きかたです。"}, {"id": "wz-tsunagi", "name": "つなぎ", "reading": "つなぎ", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥚", "mapNode": "konro:toromi", "relatedTerms": ["wz-ruu", "wz-gyoko"], "description": "材料どうしを まとまりやすく する ために 加える ものです。ハンバーグの 卵や パン粉、そばの 小麦粉などが つなぎに なります。"}, {"id": "wz-nyuka", "name": "乳化", "reading": "にゅうか", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥚", "mapNode": "konro:kagaku", "relatedTerms": ["wz-tsunagi", "wz-gyoko"], "description": "本来 まざらない 水と 油が、細かい つぶに なって まざり合う ことです。マヨネーズや ドレッシングで 大事な しくみで、卵黄が つなぎ役を します。"}, {"id": "wz-netsuhensei", "name": "熱変性", "reading": "ねつへんせい", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🥩", "mapNode": "konro:kagaku", "relatedTerms": ["wz-gyoko", "wz-meiraado"], "description": "たんぱく質が 熱を 受けて 形や 性質が 変わる ことです。肉が かたく しまったり、卵が かたまったり するのは この 変化に よるものです。"}, {"id": "wz-koka", "name": "糊化", "reading": "こか", "journey": "waza", "category": "調理の科学", "difficulty": 2, "field": "調理理論", "type": "concept", "emoji": "🍚", "mapNode": "konro:kagaku", "relatedTerms": ["wz-roka", "wz-mizudoki"], "description": "でんぷんに 水を 加えて 加熱すると、やわらかく ねばりが 出る 変化です。お米が ごはんに なるのも この はたらきで、α化 とも 呼ばれます。"}, {"id": "wz-nishime", "name": "煮しめ", "reading": "にしめ", "journey": "waza", "category": "煮る", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🥕", "mapNode": "konro:niru", "relatedTerms": ["wz-fukumeni", "wz-nitsumeru"], "description": "野菜や こんにゃくなどを、煮汁が ほとんど なくなるまで じっくり 煮て、味を しっかり しみこませる 煮物です。おせち料理でも おなじみです。"}, {"id": "wz-anbai", "name": "塩梅", "reading": "あんばい", "journey": "waza", "category": "火加減・味つけ", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🧂", "mapNode": "konro:aji", "relatedTerms": ["wz-ajimi", "wz-kakushiaji"], "description": "料理の 味の ぐあいの ことです。むかしは 塩と 梅酢で 味を つけた ことから 生まれた ことばと 言われます。「いい 塩梅」のように 使います。"}, {"id": "wz-nitsumeru", "name": "煮詰める", "reading": "につめる", "journey": "waza", "category": "煮る", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🫕", "mapNode": "konro:niru", "relatedTerms": ["wz-nikiru", "wz-nishime"], "description": "汁を 煮て 水分を とばし、量を へらして 味を こく する ことです。たれや ソースに 照りと とろみが 出ます。"}, {"id": "wz-itameni", "name": "炒め煮", "reading": "いために", "journey": "waza", "category": "煮る", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🥕", "mapNode": "konro:itameru", "relatedTerms": ["wz-itameru", "wz-niru"], "description": "食材を 油で 炒めてから、調味料や だしを 加えて 煮る 方法です。きんぴらごぼうや 筑前煮が よく 知られています。"}, {"id": "wz-nikiru", "name": "煮切る", "reading": "にきる", "journey": "waza", "category": "火加減・味つけ", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍶", "mapNode": "konro:aji", "relatedTerms": ["wz-nitsumeru", "wz-ajimi"], "description": "みりんや 酒を 火に かけて、アルコール分を とばす ことです。お酒の においが ぬけ、まろやかな 調味料に なります。"}, {"id": "wz-ih", "name": "IH調理器", "reading": "あいえいちちょうりき", "journey": "waza", "category": "道具・機械", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "⚡", "mapNode": "konro:kikai", "relatedTerms": ["wz-dendo", "wz-nabe"], "description": "ほのおを 使わず、磁力の はたらきで 鍋 そのものを 発熱させる 調理器です。IH に 使える 鍋かどうか、たしかめて 使います。", "acceptedReadings": ["あいえいちちょうりき", "あいえっちちょうりき"]}, {"id": "wz-karameru", "name": "カラメル化", "reading": "からめるか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍯", "mapNode": "konro:kagaku", "relatedTerms": ["wz-meiraado", "wz-yakiiro"], "description": "砂糖を 加熱した ときに 茶色く 色づき、あまく こうばしい 香りが 出る 変化です。プリンの カラメルソースが よく 知られています。"}, {"id": "wz-meiraado", "name": "メイラード反応", "reading": "めいらーどはんのう", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🥩", "mapNode": "konro:kagaku", "relatedTerms": ["wz-yakiiro", "wz-karameru"], "description": "糖と アミノ酸を ふくむ 食材を 加熱すると、茶色く 色づき こうばしい 香りが 出る 反応です。ステーキや パンの 焼き色が よい 例です。"}, {"id": "wz-gyoko", "name": "凝固", "reading": "ぎょうこ", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍮", "mapNode": "konro:kagaku", "relatedTerms": ["wz-netsuhensei", "wz-gelka"], "description": "液体が かたまる ことです。卵の たんぱく質は 熱で 凝固し、茶わん蒸しや プリンは この 性質を 生かした 料理です。"}, {"id": "wz-gelka", "name": "ゲル化", "reading": "げるか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍮", "mapNode": "konro:toromi", "relatedTerms": ["wz-gyoko", "wz-toromi"], "description": "液体が ぷるんと かたまって、形を たもつ ように なる ことです。ゼラチンや 寒天で 作る ゼリーや 煮こごりが これに あたります。"}, {"id": "wz-sugatatsu", "name": "すが立つ", "reading": "すがたつ", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍮", "mapNode": "konro:musu", "relatedTerms": ["wz-gyoko", "wz-hikagen"], "description": "卵料理や とうふを 強い 火で 加熱しすぎて、中に 小さな あなが たくさん できる ことです。茶わん蒸しは 火加減に 気を つけて ふせぎます。"}, {"id": "wz-sojo", "name": "うまみの相乗効果", "reading": "うまみのそうじょうこうか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "✨", "mapNode": "konro:aji", "relatedTerms": ["wz-taihi", "wz-yokusei"], "description": "こんぶの うまみと かつお節の うまみのように、ちがう うまみを 合わせると、別々よりも ずっと 強く 感じられる ことです。"}, {"id": "wz-roka", "name": "でんぷんの老化", "reading": "でんぷんのろうか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "🍙", "mapNode": "konro:kagaku", "relatedTerms": ["wz-koka"], "description": "糊化した でんぷんが、冷えて 時間が たつと もとの かたい 状態に もどっていく 変化です。冷えた ごはんが かたく なるのは この ためです。"}, {"id": "wz-taihi", "name": "対比効果", "reading": "たいひこうか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "⚖️", "mapNode": "konro:aji", "relatedTerms": ["wz-yokusei", "wz-henchou", "wz-sojo"], "description": "ちがう 味を 合わせると、片方の 味が 強く 感じられる ことです。すいかに 塩を ふると あまく 感じるのが その 例です。"}, {"id": "wz-yokusei", "name": "抑制効果", "reading": "よくせいこうか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "⚖️", "mapNode": "konro:aji", "relatedTerms": ["wz-taihi", "wz-henchou"], "description": "ちがう 味を 合わせると、片方の 味が 弱く 感じられる ことです。コーヒーに 砂糖を 入れると にがみが やわらぐのが その 例です。"}, {"id": "wz-henchou", "name": "変調効果", "reading": "へんちょうこうか", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "⚖️", "mapNode": "konro:aji", "relatedTerms": ["wz-taihi", "wz-yokusei"], "description": "先に 味わった ものの 影響で、次に 口に した ものの 味が ちがって 感じられる ことです。塩からい ものの あとに 水を 飲むと あまく 感じるのが その 例です。"}, {"id": "wz-shinto", "name": "浸透圧", "reading": "しんとうあつ", "journey": "waza", "category": "調理の科学", "difficulty": 3, "field": "調理理論", "type": "concept", "emoji": "💧", "mapNode": "konro:kagaku", "relatedTerms": ["wz-nishime", "wz-fukumeni"], "description": "こい ほうへ 水が 引きよせられる 力の ことです。野菜に 塩を ふると 水が 出るのも、煮物に 味が しみこむのも この しくみに 関係します。"}, {"id": "wz